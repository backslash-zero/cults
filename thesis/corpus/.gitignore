node_modules/
.env
.env.local
__pycache__/
*.pyc
.DS_Store

# Full texts / excerpts — copyrighted book/article content, not meant for git.
# processed/<corpus>/... so this applies uniformly to every corpus
# (literature, miviludes, interviews, ...) under the unified processed/ root.
litterature with pdfs/
processed/*/documents/**/extracted.md
processed/*/documents/**/extracted.txt
processed/*/documents/**/pages.jsonl
processed/*/pending_annotations.jsonl
processed/*/criterion_expressions*.jsonl
processed/miviludes/expression_translations*.jsonl
metadata/miviludes_criteria_embedded.jsonl
dictionaries/concept_backbone_embedded.jsonl
dictionaries/structural_concepts_embedded.jsonl
dictionaries/conceptnet_concepts_embedded.jsonl
# Large intermediate caches, regeneratable from the cached ConceptNet dump
# (~/.conceptnet_data/, outside the repo) -- conceptnet_concepts_candidates.csv
# (the actual human-reviewable output) stays tracked.
dictionaries/conceptnet_related_raw.jsonl
dictionaries/conceptnet_term_degree.jsonl
processed/shared_space/embedding_space.jsonl
processed/shared_space/literature_balanced_sample.jsonl
processed/shared_space/pca_transform.joblib
processed/shared_space/interview_prototypes.jsonl

# Same as processed/shared_space/ above, but for the v2 (strict-verbatim
# extraction) shared space -- same large/regeneratable/copyrighted-excerpt
# reasoning. pca_transform_metadata.json, variance_curve.*, and
# analysis_config.json (small, no bulk excerpt text) stay tracked.
processed/shared_space_v2/embedding_space.jsonl
processed/shared_space_v2/literature_balanced_sample.jsonl
processed/shared_space_v2/pca_transform.joblib
processed/shared_space_v2/interview_prototypes.jsonl

# geometric-analysis toolkit output -- large, regeneratable from
# embedding_space.jsonl, and qualitative-retrieval tables carry literal
# copyrighted excerpt text (same reasoning as criterion_expressions*.jsonl
# above). thesis_corpus/interviews/metadata/initial_exemplars.csv is NOT
# covered by this -- that's the durable, manually-reviewed research record.
processed/analysis/
processed/analysis_v2/

# MIVILUDES source PDFs — same reasoning as litterature with pdfs/ above
MIVILUDES/**/*.pdf

# Extraction v2 (pilot and later full runs): every JSONL and review CSV
# carries verbatim copyrighted excerpts / participant text. The small
# pilot_selection.json / config.json / summary.json stay tracked.
processed/v2/**/*.jsonl
processed/v2/**/review/*.csv
processed/v2/**/*.zip
processed/v2/**/*.log
processed/v2/**/documents_done.txt
# Exception to the *.jsonl rule above: domain_term_vectors.jsonl (embed_domain_terms.py's
# output) holds only short candidate-entity terms and their vectors -- no verbatim excerpt
# or participant text -- and is the durable input build_shared_space.py's emergent-entities
# pooling depends on, so it stays tracked like pilot_selection.json/config.json/summary.json.
!processed/v2/**/domain_term_vectors.jsonl
# Stage-1 mirror archives (thesis_corpus.mirror_stage1) and the manifest a
# target machine unzips alongside them -- verbatim text, hand-copied only.
processed/stage1_mirror_*.zip
processed/MIRROR_MANIFEST.json
