@article{zhuFiniteExplorationInfinitedimensional2024,
  title = {Beyond the Finite: {{An}} Exploration of Infinite-Dimensional Vector Spaces},
  shorttitle = {Beyond the Finite},
  author = {Zhu, Jenny},
  date = {2024-01-24},
  journaltitle = {Theoretical and Natural Science},
