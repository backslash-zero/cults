{
  "permissions": {
    "allow": [
      "Bash(pdfinfo thesis.pdf)",
      "Bash(echo \"pass1 exit=$?\")",
      "Bash(echo \"biber exit=$?\")",
      "Bash(latexmk -C thesis.tex)",
      "Bash(echo \"exit=$?\")",
      "Bash(LC_ALL=C awk 'NR>=6 && NR<=2722' /tmp/latexmk_full.log)",
      "Bash(latexmk -pdf -f -interaction=nonstopmode thesis.tex)",
      "Bash(latexmk -pdf -f -g -interaction=nonstopmode thesis.tex)",
      "Bash(pdftotext -f 1 -l 20 thesis.pdf -)",
      "Bash(grep -iA3 \"contents\")"
    ]
  }
}
